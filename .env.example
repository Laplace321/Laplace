# Laplace 环境配置示例
# 复制此文件为 .env 并填入真实 Key

# === LLM 多提供商配置 ===
# 提供商降级链（按优先级排列，逗号分隔）
LLM_PROVIDERS=obao,dashscope

# 提供商: obao
LLM_OBAO_URL=https://x.obao.cloud/v1
LLM_OBAO_KEY=your-obao-api-key-here
LLM_OBAO_MODELS=claude-sonnet-4-6,Deepseek-V4-Flash,gpt-5.4

# 提供商: dashscope（阿里云百炼 — 支持 Responses API 兼容模式）
LLM_DASHSCOPE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_KEY=your-dashscope-api-key-here
LLM_DASHSCOPE_MODELS=qwen-plus

# 提供商: openai（取消注释并在 LLM_PROVIDERS 中添加 openai 即可启用）
# LLM_OPENAI_URL=https://api.openai.com/v1
# LLM_OPENAI_KEY=your-openai-api-key-here
# LLM_OPENAI_MODELS=gpt-4o,gpt-4o-mini

# 向后兼容旧格式（未配置 LLM_PROVIDERS 时自动回退）
# LLM_BASE_URL=https://x.obao.cloud/v1
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=claude-sonnet-4-6
# LLM_FALLBACK_MODELS=Deepseek-V4-Flash,gpt-5.4

# === CORS 白名单 ===
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# === 速率限制 ===
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_GLOBAL_PER_MINUTE=100

# === Chaldea 源码路径 ===
# CHALDEA_SRC_PATH=/path/to/your/chaldea

# === Admin 后台管理 ===
# 管理员密码哈希（SHA256）。生成方式：echo -n "your-password" | sha256sum
# 默认密码: laplace2026 → 对应哈希如下
ADMIN_PASSWORD_HASH=b87e10f7206810e0086bc3a4b704bbdfd59ade9d785275003cd863c7f390618c

# Docker 容器名称（后台"重启容器"功能需要）
# CONTAINER_NAME=laplace
